\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces H3 hexagonal spatial density visualization. Agent counts are aggregated in real-time within equal-area hexagonal cells (Resolution 10, $\approx 66$ m edge length). Normalized density is color-coded from blue (low) to red (critical), identifying high-occupancy hotspots and bottlenecks. Throttling updates to every second frame preserves 60 FPS performance without loss of spatial tracking fidelity.}}{6}{}\protected@file@percent }
\newlabel{fig:h3density}{{4}{6}{}{figure.4}{}}
